{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20
    },
    "configurePresets": [
        {
            "name": "build",
            "displayName": "Build for nRF52840 DK nRF52840",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "NCS_TOOLCHAIN_VERSION": "NONE",
                "BOARD": "nrf52840dk/nrf52840",
                "DEBUG_THREAD_INFO": true,
                "CONFIG_DEBUG_THREAD_INFO": true,
                "nrf52840-ci_DEBUG_THREAD_INFO": true
            }
        },
        {
            "name": "release",
            "displayName": "Release build for nRF52840",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "NCS_TOOLCHAIN_VERSION": "NONE",
                "BOARD": "nrf52840dk/nrf52840",
                "DEBUG_THREAD_INFO": false,
                "CONFIG_DEBUG_THREAD_INFO": false,
                "nrf52840-ci_DEBUG_THREAD_INFO": false
            }
        }
    ]
}